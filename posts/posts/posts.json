media:
  input: content
  output: /content

content:
  - name: posts
    label: نوشته‌های وبلاگ
    type: collection
    path: posts/posts
    filename: "{year}-{month}-{day}-{primary}.md"

    view:
      primary: title
      fields:
        - title
        - date
        - tag
      sort:
        - date
      default:
        sort: date
        order: desc

    fields:
      - name: title
        label: عنوان نوشته
        type: string
        required: true

      - name: date
        label: تاریخ انتشار
        type: date
        required: true

      - name: tag
        label: دسته‌بندی
        type: string

      - name: excerpt
        label: خلاصه نوشته
        type: text

      - name: body
        label: متن کامل نوشته
        type: rich-text
        required: true

    operations:
      create: true
      rename: true
      delete: true
