name: Build blog posts

on:
  push:
    branches:
      - main
    paths:
      - "posts/**/*.md"
      - "posts/*.md"
      - ".github/workflows/build-posts.yml"

permissions:
  contents: write

jobs:
  build-posts-json:
    runs-on: ubuntu-latest

    steps:
      - name: Get repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Build posts.json
        run: |
          python3 <<'PY'
          import json
          import re
          from pathlib import Path

          files = []

          for pattern in ["posts/*.md", "posts/posts/*.md"]:
              files.extend(Path(".").glob(pattern))

          files = sorted(set(files))

          posts = []

          for path in files:
              text = path.read_text(encoding="utf-8")

              title = ""
              date = ""
              tag = ""
              excerpt = ""

              if text.startswith("---"):
                  parts = text.split("---", 2)

                  if len(parts) == 3:
                      front = parts[1]
                      body = parts[2].strip()
                  else:
                      front = ""
                      body = text.strip()
              else:
                  front = ""
                  body = text.strip()

              for line in front.splitlines():
                  line = line.strip()

                  if line.startswith("title:"):
                      title = line[len("title:"):].strip().strip("'\"")

                  elif line.startswith("date:"):
                      date = line[len("date:"):].strip().strip("'\"")

                  elif line.startswith("tag:"):
                      tag = line[len("tag:"):].strip().strip("'\"")

              lines = front.splitlines()
              collecting = False
              excerpt_lines = []

              for line in lines:
                  if line.strip().startswith("excerpt:"):
                      collecting = True
                      value = line.split(":", 1)[1].strip()

                      if value:
                          excerpt_lines.append(
                              value.strip("> ").strip("'\"")
                          )
                      continue

                  if collecting:
                      if line.startswith("  "):
                          excerpt_lines.append(line.strip())
                      else:
                          break

              excerpt = " ".join(excerpt_lines).strip()

              if not title:
                  for line in body.splitlines():
                      clean = re.sub(r"[*_#`]+", "", line).strip()
                      if clean:
                          title = clean
                          break

              if not title:
                  title = path.stem

              posts.append({
                  "id": path.stem,
                  "title": title,
                  "date": date,
                  "tag": tag,
                  "excerpt": excerpt,
                  "body": body
              })

          posts.sort(
              key=lambda post: str(post.get("date", "")),
              reverse=True
          )

          output = Path("posts/posts/posts.json")
          output.parent.mkdir(parents=True, exist_ok=True)

          output.write_text(
              json.dumps(
                  posts,
                  ensure_ascii=False,
                  indent=2
              ),
              encoding="utf-8"
          )

          print(f"Built {len(posts)} posts")
          PY

      - name: Save posts.json
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add posts/posts/posts.json

          if git diff --cached --quiet; then
            echo "No changes"
          else
            git commit -m "Update blog posts index"
            git push
          fi
